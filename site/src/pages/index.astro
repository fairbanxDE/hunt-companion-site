---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
const values = [
  ['Prepare seamlessly', 'Let the companion app carry routine Hunt setup, keeping your table ready for the Showdown and Settlement phases.'],
  ['Follow the Hunt', 'Keep the story moving without interruption, with each next detail ready at just the right moment.'],
  ['Pick up the trail', 'Continue a recorded Hunt from the exact moment you stepped away, with every recorded detail ready when you return.'],
];
const features = [
  { number: '01', title: 'Select Quarry', text: 'Choose a monster and its level.', image: 'features/select-quarry.png', alt: 'White Lion Quarry selection on iPad.', focus: '18% 46%', zoom: '1.85', offset: '100px' },
  { number: '02', title: 'Extend the Hunt', text: 'Configure additional events before play.', image: 'features/select-gathering.png', alt: 'Gathering-event Placement instructions during Hunt setup on iPad.', focus: '85% 45%', zoom: '1.5', offset: '0px' },
  { number: '03', title: 'View the Board', text: 'Keep movement, markers, and the current space together.', image: 'tour/navigate-ipad.png', alt: 'Digital Hunt Board on iPad.', focus: '51% 48%', zoom: '1.42', offset: '0px' },
  { number: '04', title: 'Reveal Events', text: 'View Hunt Events and .', image: 'tour/resolve-ipad.png', alt: 'Hunt Event presentation on iPad.', focus: '57% 48%', zoom: '1.42', offset: '0px' },
  { number: '05', title: 'Local-first save', text: 'Leave and resume a Hunt without losing its recorded state.', image: 'tour/resume-ipad.png', alt: 'Saved Hunt ready to resume on iPad.', focus: '70% 52%', zoom: '1.42', offset: '0px' },
  { number: '06', title: 'Showdown handoff', text: 'Stop at the table boundary and hand the next phase back to physical play.', image: 'tour/navigate-ipad.png', alt: 'Hunt Board ready for the next physical decision on iPad.', focus: '70% 64%', zoom: '1.42', offset: '0px' },
];
---
<SiteLayout title="Hunt Companion — Guided Hunt play, designed for the table." description="Hunt Companion brings guided Hunt setup, board navigation, event recording, and local-first resume to iPhone and iPad without replacing physical play.">
  <a class="skip-link" href="#main">Skip to content</a>

  <main id="main">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">The Unofficial KD:M</p>
        <h1 id="hero-title">Hunt Companion</h1>
        <p class="hero-body">Choose a Quarry, prepare the board, resolve events, and return to a recorded Hunt without rebuilding it from memory.</p>
        <div class="hero-actions">
          <a class="primary-button" href="#features">Features<span aria-hidden="true">↘</span></a>
          <img class="app-store-badge" src={`${base}/download-on-the-app-store.svg`} alt="Download on the App Store" width="120" height="40" />
        </div>
      </div>
      <div class="hero-devices" aria-label="Hunt Companion shown on iPad and iPhone">
        <div class="orbit" aria-hidden="true"></div>
        <div class="device device-ipad"><picture><img src={`${base}/hunt-board.png`} alt="Digital Hunt Board showing a White Lion Level 1 Hunt with face-down event cards and movement controls." width="2360" height="1640" /></picture></div>
        <div class="device device-iphone"><picture><img src={`${base}/quarry-screen.png`} alt="New Hunt screen showing White Lion selected at Level 1 with other Quarry choices." width="1179" height="2556" /></picture></div>
      </div>
    </section>

    <section class="value-strip section-shell" aria-label="Why it helps">
      {values.map(([title, text]) => <article><span class="value-rule" aria-hidden="true"></span><h2>{title}</h2><p>{text}</p></article>)}
    </section>
    <section class="features section-shell" id="features" aria-labelledby="features-title">
      <div class="section-heading"><p class="eyebrow">A focused companion</p><h2 id="features-title">Everything around the Hunt.</h2><p>Useful structure for the moments between setup and the next physical decision.</p></div>
      <div class="feature-gallery">
        {features.map((feature) => (
          <article class="feature-card">
            <div class="feature-copy">
              <span class="feature-number">{feature.number}</span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
            <figure class="feature-preview" style={`--preview-focus: ${feature.focus}; --preview-zoom: ${feature.zoom}; --preview-offset: ${feature.offset}`}>
              <img src={`${base}/${feature.image}`} alt={feature.alt} width="1600" height="1280" loading="lazy" />
            </figure>
          </article>
        ))}
      </div>
    </section>

    <section class="device-note section-shell" aria-labelledby="device-title"><div><p class="eyebrow">Choose your surface</p><h2 id="device-title">One Hunt flow, two table rhythms.</h2></div><p>iPad is the shared table surface. iPhone keeps the same Hunt flow in a compact, focused layout when you are moving around the table.</p></section>
    <section class="boundary section-shell" aria-labelledby="boundary-title"><p class="eyebrow">The boundary stays clear</p><h2 id="boundary-title">Physical cards, dice, miniatures, and player decisions remain authoritative.</h2><p>Hunt Companion records and presents the state around the table. The table still decides what happened.</p></section>
  </main>
  <footer class="site-footer section-shell"><span>Hunt Companion</span><span>Assisted Hunt play, designed for the table.</span></footer>
</SiteLayout>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .wordmark-logo {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 10px;
  }

  .hero-subtitle {
    text-transform: uppercase;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 4.75vw, 5rem);
    white-space: nowrap;
    max-width: none;
  }

  .hero-actions {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 20px;
    margin-top: 22px;
  }

  .hero-actions .primary-button {
    margin-top: 0;
  }

  .app-store-badge {
    display: block;
    width: auto;
    height: 40px;
    flex: 0 0 auto;
  }

  @media (max-width: 340px) {
    .hero-actions {
      flex-wrap: wrap;
    }
  }
</style>
