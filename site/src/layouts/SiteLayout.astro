---
import '../styles/global.css';
const { title, description } = Astro.props;
const canonical = new URL('/hunt-companion-site/', Astro.site);
const pageTitle = title || 'Hunt Companion';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#201f1b" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="180x180" href={`${import.meta.env.BASE_URL}/hunt-companion-app-icon.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}/hunt-companion-app-icon.png`} />
    <meta name="application-name" content="Hunt Companion" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
