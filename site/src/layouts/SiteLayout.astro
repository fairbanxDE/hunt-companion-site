---
import '../styles/global.css';
const { title, description } = Astro.props;
const canonical = new URL('/hunt-companion-site/', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#201f1b" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/hunt-companion-app-icon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/hunt-companion-app-icon.png`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
